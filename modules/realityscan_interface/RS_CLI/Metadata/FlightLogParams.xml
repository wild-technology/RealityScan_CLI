<Configuration id="{93DBD041-AE1C-4631-89BC-D9430FCED843}">
  <entry key="ifuuInhEn" value="true"/>
  <entry key="ifCSopt" value="1"/>
  <!-- 14-column RUMI format (13 + per-image FocalLength). The GUID is
       resolved against flightlogs.xml in the RealityScan INSTALL, not the
       repo copy: when it is missing there the import does NOT fail, it
       falls back and silently drops the columns the format defined. That
       happened twice (orientation accuracies lost on every import before
       2026-08-16), so modules/flightlog_format.assert_format_installed()
       now gates every import on this GUID being present. -->
  <entry key="gpsLogFileFormat" value="{D1F2A3B4-5C6D-4E7F-8A9B-0C1D2E3F4A5B}"/>
  <!-- UTM template. The zone below is only the last cruise's placeholder:
       write_flight_log_params() (modules/flight_logs.py) rewrites BOTH
       coordinate-system entries from the flight log's own filename tag
       (e.g. flight_log_53N_UTM.txt) before every import. Local-frame
       campaigns (COLMAP local:1 priors, e.g. ON2026) must use
       FlightLogParamsLocal.xml instead - importing through the wrong
       frame imports silently in the wrong frame (2026-08-07 incident,
       exit code 0). -->
  <entry key="CoordinateSystemFlightLog" value="+proj=utm +zone=57 +south +datum=WGS84 +units=m +no_defs"/>
  <entry key="CoordinateSystemFlightLogType" value="epsg:32757 - WGS 84 / UTM zone 57S"/>
  <entry key="ifKGrp" value="2"/>
  <entry key="csvFLIgn" value="true"/>
  <entry key="ifuuInh" value="0"/>
  <entry key="ifKmode" value="0x0"/>
  <entry key="csvFLSep" value="1"/>
  <entry key="ifUsePosAcc" value="true"/>
  <entry key="ifUseOriAcc" value="true"/>
</Configuration>