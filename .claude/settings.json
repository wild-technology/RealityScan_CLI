{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py -3.13 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_rs_launch.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py -3.13 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_charter_writes.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py -3.13 \"$CLAUDE_PROJECT_DIR/.claude/hooks/normalize_crlf.py\""
          }
        ]
      }
    ]
  }
}
